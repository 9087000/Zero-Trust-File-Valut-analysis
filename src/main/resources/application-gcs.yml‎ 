server:
  port: 8084

spring:
  application:
    name: zerovault-analysis-service

  datasource:
    url: ${DB_URL}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    database-platform: org.hibernate.dialect.PostgreSQLDialect

jwt:
  issuer: zerovault-auth
  secret: ${JWT_SECRET}

zerovault:
  storage:
    bucket: zerovault-dev-storage
  file-service-url: http://localhost:8083

gcp:
  credentials:
    path: ${GCP_CREDENTIALS:/app/gcp-key.json}

razorpay:
  key-id: ${RAZORPAY_KEY_ID}
  key-secret: ${RAZORPAY_KEY_SECRET}